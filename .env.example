# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Node/AI Studio preview server listening port
PORT="3000"

# AUTH_SECRET & SESSION_SECRET: Required in production
# - Cloudflare Workers: set via `npx wrangler secret put AUTH_SECRET` & `SESSION_SECRET` (or .dev.vars for local wrangler dev)
# - Node preview / server: set in environment variables
AUTH_SECRET="REPLACE_WITH_MIN_32_CHAR_RANDOM_HEX"
SESSION_SECRET="REPLACE_WITH_MIN_32_CHAR_RANDOM_HEX"

# ENTRY_PIN_HASH (optional override): PBKDF2-SHA256 ("pbkdf2_sha256:...") or bcrypt ("$2b$...") hash of entry PIN
# Keep default or configure securely as a Worker/server secret. Never hardcode plaintext PIN in frontend bundles.
# ENTRY_PIN_HASH=""

# GCS_BUCKET: Optional for standalone Node + Litestream SQLite replication (not used on Cloudflare D1)
# GCS_BUCKET="new-bhama-fashions-erp-data"
