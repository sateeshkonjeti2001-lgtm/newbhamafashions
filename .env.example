# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server listening port (must match Dockerfile EXPOSE and Cloud Run --port 3000)
PORT="3000"

# AUTH_SECRET & SESSION_SECRET: Required in production (injected via Google Secret Manager on Cloud Run)
AUTH_SECRET="REPLACE_WITH_MIN_32_CHAR_RANDOM_HEX"
SESSION_SECRET="REPLACE_WITH_MIN_32_CHAR_RANDOM_HEX"

# GCS_BUCKET: Private Google Cloud Storage bucket name for Litestream SQLite replication in production
GCS_BUCKET="new-bhama-fashions-erp-data"

# ENTRY_PIN_HASH (or ENTRY_PIN): Server-side entry gate PIN verifier (optional override; store via Secret Manager in Cloud Run)
# ENTRY_PIN_HASH="$2b$10$..."

