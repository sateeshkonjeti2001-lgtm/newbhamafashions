{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newbhamafashions",
  "main": "worker.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "new-bhama-fashions-erp-db",
      "database_id": "b2c08216-28af-4b65-9e6c-88fb07388143",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "NODE_ENV": "production"
  },
  "triggers": {
    "crons": ["30 16 * * *"]
  }
}
