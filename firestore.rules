rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the verified store owner Google account has access to cloud backup / sync collections
    function isStoreOwner() {
      return request.auth != null && 
        request.auth.token.email == 'sateeshkonjeti2001@gmail.com';
    }

    match /cloud_backups/{backupId} {
      allow read, write: if isStoreOwner();
    }

    match /google_sync_logs/{logId} {
      allow read, write: if isStoreOwner();
    }

    match /manual_bills/{billId} {
      allow read, write: if isStoreOwner();
    }

    match /test/connection {
      allow read: if isStoreOwner();
    }
  }
}
