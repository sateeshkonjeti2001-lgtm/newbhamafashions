rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /cloud_backups/{backupId} {
      allow read, write: if isSignedIn();
    }

    match /google_sync_logs/{logId} {
      allow read, write: if isSignedIn();
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
