{
  "entities": {
    "cloudBackup": {
      "title": "Cloud Backup Record",
      "description": "Metadata for cloud backups and synchronization logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "filename": { "type": "string" },
        "createdAt": { "type": "string" },
        "fileSize": { "type": "number" },
        "sha256": { "type": "string" },
        "status": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "filename", "createdAt", "status"]
    },
    "googleSyncLog": {
      "title": "Google Sync Log",
      "description": "Log entry of data sync with Google Sheets or Google Calendar",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["sheets_export", "sheets_import", "calendar_event"] },
        "timestamp": { "type": "string" },
        "details": { "type": "string" },
        "userEmail": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "type", "timestamp", "status"]
    },
    "manualBill": {
      "title": "Manual Handwritten Bill",
      "description": "Customer handwritten bill record entered without POS inventory deduction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "billNumber": { "type": "string" },
        "billDate": { "type": "string" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["CASH", "UPI", "SPLIT", "CREDIT"] },
        "cashAmount": { "type": "number" },
        "upiAmount": { "type": "number" },
        "dueAmount": { "type": "number" },
        "itemCount": { "type": "number" },
        "items": { "type": "array" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "billNumber", "billDate", "totalAmount", "paymentMethod", "items"]
    }
  },
  "firestore": {
    "/cloud_backups/{backupId}": {
      "schema": "cloudBackup",
      "description": "Backup archive records and cloud storage synchronization status"
    },
    "/google_sync_logs/{logId}": {
      "schema": "googleSyncLog",
      "description": "Audit records of Google Sheets exports and Google Calendar event schedules"
    },
    "/manual_bills/{billId}": {
      "schema": "manualBill",
      "description": "Manual handwritten customer bills entered without inventory deduction"
    }
  }
}
